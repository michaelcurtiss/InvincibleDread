\par\plain \f0\fs24\b0\i0\cf1
\par\pard\plain \sa180\sb180\ltrch\loch {If you want the sensual temptation to matter more, make C\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s pose }{\f0\fs24\i1 directly}{ interfere with A\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s ability to hear or see the ox. For example:}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls1\ilvl0{\listtext	 \uc0\u8226 	}{She positions herself so A must look past her body to see the ox.}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{B uses her body as a shield or lure to pull A\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s attention away.}
