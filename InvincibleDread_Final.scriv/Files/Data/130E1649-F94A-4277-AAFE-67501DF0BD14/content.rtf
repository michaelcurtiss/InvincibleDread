\par\plain \f0\fs24\b0\i0
\par\plain {\f0\fs24\b0\i0 Leave?}
\par\plain {\f0\fs24\b0\i0 I\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92m here for something.}
