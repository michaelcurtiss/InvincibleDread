\paperw12240\paperh15840\margl1800\margr1800\margt1440\margb1440\f0\fs24\cf0
\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55356\'3F\u57263\'3F Core takeaway<!$Scr_H::2>}
\par\pard\plain \sa180\sb180\ltrch\loch {Free indirect style works when }{\f0\fs24\b1 the narration quietly slips into the character\loch\af1\hich\af1\dbch\af1\uc1\u8217\'92s subjective language, rhythms, and judgments}{, while still remaining grammatically in third person.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55358\'3F\u56800\'3F What makes free indirect style distinct<!$Scr_H::2>}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls1\ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Third person grammar}{ (\loch\af0\hich\af0\dbch\af0\uc1\u8220\'93she walked,\u8221\'94 \u8220\'93he wondered\u8221\'94)}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 First person flavor}{ (the character\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s vocabulary, biases, emotional coloration)}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 No reporting verbs}{ (\loch\af0\hich\af0\dbch\af0\uc1\u8220\'93she thought,\u8221\'94 \u8220\'93he felt\u8221\'94)}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Narrator and character voices fuse}{, creating a porous boundary between them}
\par\pard\plain \sa180\sb180\ltrch\loch {It\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s the difference between:}
\par\pard\plain \sa180\sb180\ltrch\loch {She wondered if he would call. vs. He would call. Of course he would. Any minute now.}
\par\pard\plain \sa180\sb180\ltrch\loch {The second example is still third person, but the }{\f0\fs24\i1 mindset}{ is hers.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55357\'3F\u57056\'3F Techniques to achieve free indirect style<!$Scr_H::2>}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>1. Let the narration adopt the character\loch\af1\hich\af1\dbch\af1\uc1\u8217\'92s vocabulary<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {A shy character won\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t describe someone as \u8220\'93a bombshell\u8221\'94; a snobbish character might. A child won\u8217\'92t think \u8220\'93melancholy,\u8221\'94 but \u8220\'93sad\u8221\'94 or \u8220\'93weird.\u8221\'94}
\par\plain {\f0\fs24\b1 Technique:}{ Build a lexicon for each character and let the narration borrow from it.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>2. Use character-specific metaphors and comparisons<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {If your character is a carpenter, they\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92ll think in wood and angles. If they\u8217\'92re anxious, their metaphors will be jittery, catastrophic.}
\par\plain {This is one of the strongest signals of free indirect style.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>3. Tilt the narration toward the character\loch\af1\hich\af1\dbch\af1\uc1\u8217\'92s emotional logic<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Free indirect style often bends reality toward the character\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s feelings.}
\par\pard\plain \sa180\sb180\ltrch\loch {The hallway stretched forever. Everyone was staring. Obviously.}
\par\pard\plain \sa180\sb180\ltrch\loch {The hallway isn\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t literally stretching; that\u8217\'92s the character\u8217\'92s perception bleeding into narration.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>4. Use selective syntax shifts<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Characters have distinct rhythms:}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls2\ilvl0{\listtext	 \uc0\u8226 	}{Short, clipped thoughts for anger or panic}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{Long, spiraling sentences for rumination}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{Fragmentation for shock or denial}
\par\pard\plain \sa180\sb180\ltrch\loch {Let the narration adopt those rhythms without switching to first person.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>5. Let judgments appear without attribution<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Instead of:}
\par\pard\plain \sa180\sb180\ltrch\loch {She thought the dress was hideous.}
\par\pard\plain \sa180\sb180\ltrch\loch {Try:}
\par\pard\plain \sa180\sb180\ltrch\loch {Hideous dress.}
\par\pard\plain \sa180\sb180\ltrch\loch {No \loch\af0\hich\af0\dbch\af0\uc1\u8220\'93she thought\u8221\'94\hich\f0 \emdash \loch\f0 the judgment simply appears.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>6. Strategically blur the boundary between narrator and character<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Free indirect style is strongest when the reader isn\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t sure who \u8220\'93owns\u8221\'94 the sentence.}
\par\pard\plain \sa180\sb180\ltrch\loch {He walked into the room. Perfect. Just what he needed\hich\f0 \emdash \loch\f0 everyone staring.}
\par\pard\plain \sa180\sb180\ltrch\loch {The narrator reports the action; the character supplies the sarcasm.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>7. Use temporal markers that feel like thoughts<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Words like }{\f0\fs24\i1 now}{, }{\f0\fs24\i1 of course}{, }{\f0\fs24\i1 really}{, }{\f0\fs24\i1 already}{, }{\f0\fs24\i1 finally}{, }{\f0\fs24\i1 still}{ often signal interiority.}
\par\pard\plain \sa180\sb180\ltrch\loch {She hadn\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t even finished her coffee and already they were asking for favors.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>8. Avoid over-explaining the shift<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Don\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t announce the character\u8217\'92s thoughts. Just let the narration slide into them.}
\par\pard\plain \sa180\sb180\ltrch\loch {She looked at the clock. Late again. Fantastic.}
\par\pard\plain \sa180\sb180\ltrch\loch {No \loch\af0\hich\af0\dbch\af0\uc1\u8220\'93she thought,\u8221\'94 no italics\hich\f0 \emdash \loch\f0 just a tonal shift.}
\par\pard\plain \sa180\sb210\ltrch\loch {\f0\fs28\b1 <$Scr_H::3>9. Practice \loch\af1\hich\af1\dbch\af1\uc1\u8220\'93zooming\u8221\'94<!$Scr_H::3>}
\par\pard\plain \sa180\sb180\ltrch\loch {Move fluidly between:}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls3\ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Objective description}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Subjective shading}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Full interiority}
\par\pard\plain \sa180\sb180\ltrch\loch {Free indirect style thrives on this dynamic motion.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55358\'3F\u56810\'3F A quick exercise you can try<!$Scr_H::2>}
\par\pard\plain \sa180\sb180\ltrch\loch {Take a neutral sentence:}
\par\pard\plain \sa180\sb180\ltrch\loch {She walked into the meeting room.}
\par\pard\plain \sa180\sb180\ltrch\loch {Now rewrite it in free indirect style for three different characters:}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls4\ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Anxious character:}{ }{\f0\fs24\i1 She walked into the meeting room. Too bright. Too many people. Why were they all looking at her?}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Arrogant character:}{ }{\f0\fs24\i1 She walked into the meeting room. Finally\hich\f2 \emdash \loch\f2 someplace where her competence might actually be noticed.}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 Exhausted character:}{ }{\f0\fs24\i1 She walked into the meeting room. Great. Another hour of pretending she wasn\loch\af2\hich\af2\dbch\af2\uc1\u8217\'92t running on fumes.}
\par\pard\plain \sa180\sb180\ltrch\loch {Same grammar, different interiority.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55357\'3F\u56589\'3F One non-obvious insight<!$Scr_H::2>}
\par\pard\plain \sa180\sb180\ltrch\loch {Free indirect style works best when }{\f0\fs24\b1 you trust the reader}{. If you try to control every shift\hich\f0 \emdash \loch\f0 explaining, clarifying, tagging thoughts\hich\f0 \emdash \loch\f0 you break the spell. The technique thrives on subtlety: the reader senses the mind behind the narration without being told.}
\par\plain 
\par\plain 
\par\plain 
\par\plain {Here\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s a tighter free\_indirect rendering that keeps the memory as part of her }{\f0\fs24\i1 current}{ self\_justification:}
\par\pard\plain \sa180\sb180\ltrch\loch {\f0\fs24\b1 She held her chin high. Why shouldn\loch\af1\hich\af1\dbch\af1\uc1\u8217\'92t she? At ten she\u8217\'92d jumped higher than anyone\hich\f1 \emdash \loch\f1 still could, probably.}
\par\pard\plain \sa180\sb180\ltrch\loch {This works because:}
\par\pard\plain \li540\fi-270\sa180\sb180\ltrch\loch \ls5\ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 \loch\af1\hich\af1\dbch\af1\uc1\u8220\'93She held her chin high\u8221\'94}{ is an observable action, not a narrated judgment.}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 \loch\af1\hich\af1\dbch\af1\uc1\u8220\'93Why shouldn\u8217\'92t she?\u8221\'94}{ is pure interior voice.}
\par\plain \ilvl0{\listtext	 \uc0\u8226 	}{\f0\fs24\b1 \loch\af1\hich\af1\dbch\af1\uc1\u8220\'93At ten she\u8217\'92d jumped higher than anyone\hich\f1 \emdash \loch\f1 still could, probably.\u8221\'94}{ blends past and present the way a real thought does.}
\par\pard\plain \sa180\sb180\ltrch\loch {It stays anchored in the moment because the memory is functioning as her }{\f0\fs24\i1 current reasoning}{, not as a narrator\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92s exposition.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55358\'3F\u56813\'3F The principle<!$Scr_H::2>}
\par\pard\plain \sa180\sb180\ltrch\loch {A memory in free indirect style must feel like:}
\par\plain {\f0\fs24\b1 a thought she is having right now}{, not }{\f0\fs24\b1 a fact the narrator is supplying.}
\par\plain {If the memory is part of her present emotional logic, it doesn\loch\af0\hich\af0\dbch\af0\uc1\u8217\'92t pull the reader out of the scene.}
\par\pard\plain \sa180\sb240\ltrch\loch {\f0\fs36\b1 <$Scr_H::2>\loch\af1\hich\af1\dbch\af1\uc1\u55357\'3F\u56615\'3F A diagnostic you can use<!$Scr_H::2>}
\par\pard\plain \sa180\sb180\ltrch\loch {Ask yourself:}
\par\plain {\f0\fs24\b1 Does this sentence feel like something the character would think }{\f0\fs24\b1\i1 in this moment}{\f0\fs24\b1 ?}
\par\plain {If yes \loch\af0\hich\af0\dbch\af0\uc1\u8594\'3F it\u8217\'92s free indirect. If no \u8594\'3F it\u8217\'92s narration.}
\par\plain {If you want, you can show me the surrounding paragraph and I can help you tune the free\_indirect voice so the whole scene stays tight and immediate.}}